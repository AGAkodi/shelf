{
  "name": "shelf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && npm run db:seed:storage",
    "db:seed:storage": "node scripts/seed-storage.mjs",
    "db:types": "node scripts/generate-db-types.mjs",
    "test:db": "supabase test db && node --test --test-concurrency=1 tests/database/api.test.mjs",
    "dev:local": "node scripts/local-ui.mjs",
    "test:catalogue": "node scripts/local-ui.mjs --test",
    "test:borrowing": "npm run test:payments:db",
    "dev:borrowing": "npm run dev:wallet",
    "test:borrowing:ui": "npm run test:wallet:ui",
    "typecheck:functions": "deno check --config supabase/functions/deno.json supabase/functions/shelf-api/index.ts supabase/functions/wallet-auth/index.ts supabase/functions/payments/index.ts supabase/functions/payments-reconcile/index.ts",
    "test:wallet": "node --test --test-concurrency=1 tests/database/wallet.test.mjs",
    "dev:wallet": "node scripts/dev-wallet.mjs",
    "test:wallet:ui": "node scripts/test-wallet-ui.mjs",
    "test:payments:unit": "deno test --config supabase/functions/deno.json supabase/functions/payments/verify.test.ts",
    "test:payments:db": "node --test tests/database/payments.test.mjs",
    "test:dist": "playwright test --config playwright.dist.config.ts",
    "serve:dist": "node scripts/serve-dist.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@nimiq/mini-app-sdk": "^0.2.4",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.66.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "viem": "2.57.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "deno": "2.9.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "supabase": "3.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
