# Browser-public values only. Leave Supabase blank to use the foundation shell.
# Copy to .env.local. Never add service-role keys, secret keys or RPC secrets.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional canonical application origin; blank uses the current browser origin.
VITE_APP_URL=

# Local-only; normally supplied by npm run dev:borrowing. Ignored by production builds.
VITE_DEV_BORROWING=
# Server-only Edge settings are documented in README; never prefix them with VITE_.
